def filter_hmm_result(file, evalue=1e-10, hmmCov = 0.30):
# read in dataframe from processed hmm domtblout file
    df = pd.read_csv(file, sep="\t", header=None, 
                     skiprows=1, # if newer dbcan, skip first row, because this files has headers
                 names=["targetName", "targetLength", "queryName", "queryLength", "evalue", 
                        "qFrom", "qTo", "tFrom", "tTo", "hmmCov"])
    # filter by evalue threshold
    
    print("Processing hmmsearch results from sample {file}".format(file = file))
    print("Starting with {} rows which contain {} unique contigs aligned to {} HMM profiles.".format(df.shape[0], 
                                                                                                   df["queryName"].unique().shape[0], 
                                                                                                   df["targetName"].unique().shape[0]))
    df = df[df.evalue < evalue]
    print("Rows after filtering for evalue < {evalue}: {rows}".format(evalue = evalue , rows = df.shape[0]))
    # filter duplicate reads, only keep best hit by evalue
    df = df.loc[df.groupby('queryName')['evalue'].idxmin()]
    print("Rows after removing duplicate reads: {rows}".format(rows = df.shape[0]))
    # remove .hmm
    df['targetName'] = df['targetName'].str.replace('.hmm', '')
    df['queryName'] = df['queryName'].str.replace(r'_[0-9]+$', '')
    return(df)

  filter_hmm_result(files[1])

  samples = pd.read_csv("samples.txt", header=None, names=["Name"])["Name"]
df_build = {}
for s in samples:
    hmm_file = "06_dbCAN_run_v4/" + s + "/hmmer.out"
    df = filter_hmm_result(hmm_file)
    ab_file = "06_Trinity/abundance-RSEM/"+ s + "_RSEM.isoforms.results"
    ab = pd.read_csv(ab_file, sep="\t")
    df2 = pd.merge(df, ab, left_on = "queryName", right_on = "transcript_id", how="left")[["targetName","transcript_id","expected_count", "TPM", "FPKM"]]
    df_build[s] = df2.groupby("targetName").sum()

  resdf = []
for key, df in df_build.items():
    resdf.append(df.rename(columns={"expected_count": key})[key])
resdf= pd.DataFrame(resdf).T
resdf.fillna(0).to_csv("06_dbCAN_run_v4/CAZy_expected_counts_hmm_from_run_dbCAN.tsv", sep="\t")

